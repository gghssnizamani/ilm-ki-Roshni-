function getLib(){try{return JSON.parse(localStorage.getItem("vv_lib")||"[]")}catch(e){return[]}}
function saveLib(o){try{const a=getLib();a.unshift(o);localStorage.setItem("vv_lib",JSON.stringify(a.slice(0,20)))}catch(e){}}
function renderLib(){const a=getLib(),c=$("lib");c.innerHTML="";if(!a.length){c.innerHTML='<div class="empty">'+t().empty+"</div>";return}
 a.forEach(v=>{const b=document.createElement("button");b.className="it";b.innerHTML='<div class="em">'+(ICON[v.subject]||"🎬")+"</div><div><b></b><br><small>"+v.scenes.length+" "+TXT[v.lang].scene+" · "+(v.lang==="ur"?"اردو":"English")+"</small></div>";b.querySelector("b").textContent=v.title;b.onclick=()=>{curTitle=v.title;EX=v.ex||null;TT=v.title;tab("c");load(v.scenes,v.lang,v.subject)};c.appendChild(b)})}
function bg(s){let h="";for(let i=0;i<6;i++)h+='<span class="fl" style="left:'+(8+i*16)+'%;animation-delay:'+(-i*1.5)+'s">'+ICON[s]+"</span>";$("fl").innerHTML=h}
function unlock(){try{const u=new SpeechSynthesisUtterance(" ");u.volume=0;speechSynthesis.speak(u)}catch(e){}}
try{speechSynthesis.getVoices();speechSynthesis.onvoiceschanged=()=>{}}catch(e){}
